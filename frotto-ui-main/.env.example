# Copie para .env (dev local) e preencha com os valores do seu ambiente.
# Nenhum destes valores é secreto — são apenas URLs públicas consumidas pelo build do
# Create React App (todo REACT_APP_* é embutido no bundle JS, nunca use este prefixo
# para chaves privadas de futuros provedores de pagamento).

# URL da API usada em desenvolvimento (perfil dev do backend, ex.: http://localhost:8080)
REACT_APP_SERVER_URL=http://localhost:8080

# URL pública do bucket S3 onde ficam os arquivos/imagens do app
REACT_APP_S3_URL=https://exemplo-bucket.s3.amazonaws.com/

# URL da API usada em produção/build (ex.: https://api.frotto.com.br)
REACT_APP_API_URL=https://api.frotto.com.br
