<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        Etapa 2.2: the debtor of a pendency is a driver, frozen when the pendency is recorded. driver_car_id is kept
        untouched as the historical origin (contract/car where the debt was born).
    -->
    <changeSet id="20261005000000-1" author="claude">
        <addColumn tableName="pendency">
            <column name="debtor_driver_id" type="bigint"/>
        </addColumn>
        <!--
            Backfill only through the pendency's own contract: the driver of that driver_car. Rows without contract,
            with a contract that no longer exists or without driver stay NULL - never guessed by car, plate or name.
        -->
        <sql>
            UPDATE pendency
            SET debtor_driver_id = (SELECT dc.driver_id FROM driver_car dc WHERE dc.id = pendency.driver_car_id)
            WHERE debtor_driver_id IS NULL AND driver_car_id IS NOT NULL
        </sql>
        <createIndex tableName="pendency" indexName="idx_pendency_debtor_driver">
            <column name="debtor_driver_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="pendency" baseColumnNames="debtor_driver_id" referencedTableName="driver" referencedColumnNames="id" constraintName="fk_pendency__debtor_driver_id"/>
    </changeSet>
</databaseChangeLog>
