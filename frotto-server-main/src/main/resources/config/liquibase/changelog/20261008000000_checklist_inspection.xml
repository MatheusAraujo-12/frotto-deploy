<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!--
        Checklist de Entrega/Devolução as the operation of a contract (additive only, no backfill):
        - driver_car_id: the contract (driver_car) the checklist delivers or returns; NULL for historical checklists.
        - checklist_type: ENTREGA / DEVOLUCAO, structural; NULL for historical checklists (payload.tipo stays as it was).
        - final_checklist_slot: set to checklist_type only when the checklist becomes FINAL. UNIQUE with driver_car_id:
          at most one FINAL Entrega and one FINAL Devolução per contract (drafts and NULLs never collide).
        FKs are RESTRICT: a contract with checklists and a document that generated an inspection stay traceable.
    -->
    <changeSet id="20261008000000-1" author="claude">
        <addColumn tableName="driver_document">
            <column name="driver_car_id" type="bigint"/>
            <column name="checklist_type" type="varchar(20)"/>
            <column name="final_checklist_slot" type="varchar(20)"/>
        </addColumn>
        <addUniqueConstraint
            tableName="driver_document"
            columnNames="driver_car_id, final_checklist_slot"
            constraintName="ux_driver_document_final_checklist"
        />
        <addForeignKeyConstraint
            baseTableName="driver_document"
            baseColumnNames="driver_car_id"
            referencedTableName="driver_car"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            constraintName="fk_driver_document__driver_car_id"
        />
    </changeSet>

    <!--
        The inspection generated by a finalized checklist: origin_document_id is UNIQUE (one inspection per checklist,
        whatever retries happen), driver_car_id is the contract, fuel_level the structured fuel gauge. All NULL for every
        existing (manual) inspection.
    -->
    <changeSet id="20261008000000-2" author="claude">
        <addColumn tableName="inspection">
            <column name="origin_document_id" type="bigint"/>
            <column name="driver_car_id" type="bigint"/>
            <column name="fuel_level" type="varchar(20)"/>
        </addColumn>
        <addUniqueConstraint tableName="inspection" columnNames="origin_document_id" constraintName="ux_inspection_origin_document"/>
        <createIndex tableName="inspection" indexName="idx_inspection_driver_car">
            <column name="driver_car_id"/>
        </createIndex>
        <addForeignKeyConstraint
            baseTableName="inspection"
            baseColumnNames="origin_document_id"
            referencedTableName="driver_document"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            constraintName="fk_inspection__origin_document_id"
        />
        <addForeignKeyConstraint
            baseTableName="inspection"
            baseColumnNames="driver_car_id"
            referencedTableName="driver_car"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            constraintName="fk_inspection__driver_car_id"
        />
    </changeSet>
</databaseChangeLog>
